# Required: Supabase project URL and publishable key (Supabase > Project Settings > API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Required, server only: Supabase secret key (preferred) OR the legacy service_role JWT key.
# Never prefix this with NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SECRET_KEY=YOUR_SERVICE_SECRET_KEY
# SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_JWT

# Optional. The app derives the callback origin from the request when unset.
NEXT_PUBLIC_SITE_URL=https://YOUR_VERCEL_DOMAIN
